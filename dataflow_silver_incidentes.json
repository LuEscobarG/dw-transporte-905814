{
    "typeProperties":  {
                           "sources":  [
                                           {
                                               "name":  "SourceBronzeIncidentes",
                                               "dataset":  {
                                                               "referenceName":  "DS_Bronze_Incidentes",
                                                               "type":  "DatasetReference"
                                                           }
                                           }
                                       ],
                           "sinks":  [
                                         {
                                             "name":  "SinkSilverIncidentes",
                                             "dataset":  {
                                                             "referenceName":  "DS_Silver_Incidentes",
                                                             "type":  "DatasetReference"
                                                         }
                                         }
                                     ],
                           "scriptLines":  [
                                               "source(",
                                               "allowSchemaDrift: true,",
                                               "validateSchema: false,",
                                               "format: \u0027table\u0027",
                                               ") ~\u003e SourceBronzeIncidentes",
                                               "SourceBronzeIncidentes derive(",
                                               "    AnioFuenteLimpio = toShort(trim(toString(byName(\u0027AnioFuente\u0027)))),",
                                               "    IncidenteIdLimpio = upper(trim(toString(byName(\u0027IncidenteId\u0027)))),",
                                               "    TipoIncidenteLimpio = upper(trim(toString(byName(\u0027TipoIncidente\u0027)))),",
                                               "    SeveridadLimpia = upper(trim(toString(byName(\u0027Severidad\u0027)))),",
                                               "    InicioRaw = trim(toString(byName(\u0027FechaHoraInicio\u0027))),",
                                               "    FinRaw = trim(toString(byName(\u0027FechaHoraFin\u0027))),",
                                               "    RegistroRaw = trim(toString(byName(\u0027FechaHoraRegistro\u0027))),",
                                               "    VehiculoOriginal = upper(trim(toString(byName(\u0027VehiculoId\u0027)))),",
                                               "    DescripcionLimpia = trim(toString(byName(\u0027Descripcion\u0027)))",
                                               ") ~\u003e PrepararIncidentes",
                                               "PrepararIncidentes derive(",
                                               "    FechaHoraInicioLimpia = case(",
                                               "        instr(upper(InicioRaw), \u0027AM\u0027) \u003e 0 || instr(upper(InicioRaw), \u0027PM\u0027) \u003e 0,",
                                               "            toTimestamp(InicioRaw, \u0027M/d/yyyy h:mm:ss a\u0027),",
                                               "        instr(InicioRaw, \u0027T\u0027) \u003e 0,",
                                               "            toTimestamp(",
                                               "                concat(",
                                               "                    left(InicioRaw, 10),",
                                               "                    \u0027 \u0027,",
                                               "                    substring(InicioRaw, instr(InicioRaw, \u0027T\u0027) + 1, 8)",
                                               "                ),",
                                               "                \u0027yyyy-MM-dd HH:mm:ss\u0027",
                                               "            ),",
                                               "        instr(InicioRaw, \u0027/\u0027) \u003e 0,",
                                               "            toTimestamp(InicioRaw, \u0027dd/MM/yyyy HH:mm\u0027),",
                                               "        toTimestamp(InicioRaw, \u0027yyyy-MM-dd HH:mm\u0027)",
                                               "    ),",
                                               "    FechaHoraFinLimpia = case(",
                                               "        instr(upper(FinRaw), \u0027AM\u0027) \u003e 0 || instr(upper(FinRaw), \u0027PM\u0027) \u003e 0,",
                                               "            toTimestamp(FinRaw, \u0027M/d/yyyy h:mm:ss a\u0027),",
                                               "        instr(FinRaw, \u0027T\u0027) \u003e 0,",
                                               "            toTimestamp(",
                                               "                concat(",
                                               "                    left(FinRaw, 10),",
                                               "                    \u0027 \u0027,",
                                               "                    substring(FinRaw, instr(FinRaw, \u0027T\u0027) + 1, 8)",
                                               "                ),",
                                               "                \u0027yyyy-MM-dd HH:mm:ss\u0027",
                                               "            ),",
                                               "        instr(FinRaw, \u0027/\u0027) \u003e 0,",
                                               "            toTimestamp(FinRaw, \u0027dd/MM/yyyy HH:mm\u0027),",
                                               "        toTimestamp(FinRaw, \u0027yyyy-MM-dd HH:mm\u0027)",
                                               "    ),",
                                               "    FechaHoraRegistroLimpia = case(",
                                               "        instr(upper(RegistroRaw), \u0027AM\u0027) \u003e 0 || instr(upper(RegistroRaw), \u0027PM\u0027) \u003e 0,",
                                               "            toTimestamp(RegistroRaw, \u0027M/d/yyyy h:mm:ss a\u0027),",
                                               "        instr(RegistroRaw, \u0027T\u0027) \u003e 0,",
                                               "            toTimestamp(",
                                               "                concat(",
                                               "                    left(RegistroRaw, 10),",
                                               "                    \u0027 \u0027,",
                                               "                    substring(RegistroRaw, instr(RegistroRaw, \u0027T\u0027) + 1, 8)",
                                               "                ),",
                                               "                \u0027yyyy-MM-dd HH:mm:ss\u0027",
                                               "            ),",
                                               "        instr(RegistroRaw, \u0027/\u0027) \u003e 0,",
                                               "            toTimestamp(RegistroRaw, \u0027dd/MM/yyyy\u0027),",
                                               "        length(RegistroRaw) == 10,",
                                               "            toTimestamp(RegistroRaw, \u0027yyyy-MM-dd\u0027),",
                                               "        toTimestamp(RegistroRaw)",
                                               "    ),",
                                               "    VehiculoIdLimpio = case(",
                                               "        isNull(VehiculoOriginal) || VehiculoOriginal == \u0027\u0027 || VehiculoOriginal == \u0027NULL\u0027,",
                                               "            toString(null()),",
                                               "        VehiculoOriginal == \u0027V-043\u0027 \u0026\u0026 AnioFuenteLimpio \u003c= 2023,",
                                               "            \u0027V-043-OLD\u0027,",
                                               "        startsWith(VehiculoOriginal, \u0027V-\u0027),",
                                               "            VehiculoOriginal,",
                                               "        concat(",
                                               "            \u0027V-\u0027,",
                                               "            lpad(regexExtract(VehiculoOriginal, \u0027(\\\\d+)\u0027, 1), 3, \u00270\u0027)",
                                               "        )",
                                               "    )",
                                               ") ~\u003e NormalizarIncidentes",
                                               "NormalizarIncidentes select(mapColumn(",
                                               "    AnioFuente = AnioFuenteLimpio,",
                                               "    IncidenteId = IncidenteIdLimpio,",
                                               "    TipoIncidente = TipoIncidenteLimpio,",
                                               "    Severidad = SeveridadLimpia,",
                                               "    FechaHoraInicio = FechaHoraInicioLimpia,",
                                               "    FechaHoraFin = FechaHoraFinLimpia,",
                                               "    FechaHoraRegistro = FechaHoraRegistroLimpia,",
                                               "    VehiculoId = VehiculoIdLimpio,",
                                               "    Descripcion = DescripcionLimpia",
                                               "),",
                                               "skipDuplicateMapInputs: true,",
                                               "skipDuplicateMapOutputs: true",
                                               ") ~\u003e SeleccionarIncidentes",
                                               "SeleccionarIncidentes alterRow(",
                                               "    upsertIf(true())",
                                               ") ~\u003e MarcarUpsert",
                                               "MarcarUpsert sink(",
                                               "allowSchemaDrift: true,",
                                               "validateSchema: false,",
                                               "deletable: false,",
                                               "insertable: false,",
                                               "updateable: false,",
                                               "upsertable: true,",
                                               "keys:[\u0027IncidenteId\u0027],",
                                               "format: \u0027table\u0027,",
                                               "skipDuplicateMapInputs: true,",
                                               "skipDuplicateMapOutputs: true,",
                                               "errorHandlingOption: \u0027stopOnFirstError\u0027",
                                               ") ~\u003e SinkSilverIncidentes"
                                           ],
                           "transformations":  [
                                                   {
                                                       "name":  "PrepararIncidentes"
                                                   },
                                                   {
                                                       "name":  "NormalizarIncidentes"
                                                   },
                                                   {
                                                       "name":  "SeleccionarIncidentes"
                                                   },
                                                   {
                                                       "name":  "MarcarUpsert"
                                                   }
                                               ]
                       }
}
