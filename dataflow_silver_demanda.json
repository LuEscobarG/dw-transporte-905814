{
    "typeProperties":  {
                           "sources":  [
                                           {
                                               "name":  "SourceBronzeDemanda",
                                               "dataset":  {
                                                               "referenceName":  "DS_Bronze_DemandaParadas",
                                                               "type":  "DatasetReference"
                                                           }
                                           }
                                       ],
                           "sinks":  [
                                         {
                                             "name":  "SinkSilverDemanda",
                                             "dataset":  {
                                                             "referenceName":  "DS_Silver_DemandaParadas",
                                                             "type":  "DatasetReference"
                                                         }
                                         }
                                     ],
                           "scriptLines":  [
                                               "source(",
                                               "allowSchemaDrift: true,",
                                               "validateSchema: false,",
                                               "format: \u0027table\u0027",
                                               ") ~\u003e SourceBronzeDemanda",
                                               "SourceBronzeDemanda derive(",
                                               "    AnioFuenteLimpio = toShort(trim(toString(byName(\u0027AnioFuente\u0027)))),",
                                               "    DemandaIdLimpio = upper(trim(toString(byName(\u0027DemandaId\u0027)))),",
                                               "    RutaOriginal = upper(trim(toString(byName(\u0027RutaHistoricaId\u0027)))),",
                                               "    ParadaOriginal = upper(trim(toString(byName(\u0027ParadaHistoricaId\u0027)))),",
                                               "    FechaServicioLimpia = case(",
                                               "        isInteger(trim(toString(byName(\u0027FechaServicio\u0027)))),",
                                               "            addDays(toDate(\u00271899-12-30\u0027), toInteger(trim(toString(byName(\u0027FechaServicio\u0027))))),",
                                               "        instr(upper(trim(toString(byName(\u0027FechaServicio\u0027)))), \u0027AM\u0027) \u003e 0 || instr(upper(trim(toString(byName(\u0027FechaServicio\u0027)))), \u0027PM\u0027) \u003e 0,",
                                               "            toDate(toTimestamp(trim(toString(byName(\u0027FechaServicio\u0027))), \u0027M/d/yyyy hh:mm:ss a\u0027)),",
                                               "        instr(trim(toString(byName(\u0027FechaServicio\u0027))), \u0027/\u0027) \u003e 0,",
                                               "            toDate(trim(toString(byName(\u0027FechaServicio\u0027))), \u0027dd/MM/yyyy\u0027),",
                                               "        toDate(trim(toString(byName(\u0027FechaServicio\u0027))))",
                                               "    ),",
                                               "    FranjaLimpia = trim(toString(byName(\u0027Franja\u0027))),",
                                               "    ValidacionesLimpias = toInteger(trim(toString(byName(\u0027ValidacionesTarjeta\u0027)))),",
                                               "    DescensosLimpios = toInteger(trim(toString(byName(\u0027Descensos\u0027)))),",
                                               "    NoAtendidaLimpia = toInteger(trim(toString(byName(\u0027DemandaNoAtendida\u0027)))),",
                                               "    MetodoLimpio = upper(trim(toString(byName(\u0027Metodo\u0027))))",
                                               ") ~\u003e PrepararDemanda",
                                               "PrepararDemanda derive(",
                                               "    RutaHistoricaIdLimpio = case(",
                                               "        RutaOriginal == \u0027RH-07-NEW\u0027, \u0027RH-07-NEW\u0027,",
                                               "        RutaOriginal == \u0027RH-12-N\u0027, \u0027RH-12-N\u0027,",
                                               "        RutaOriginal == \u0027R12-N\u0027, \u0027RH-12-N\u0027,",
                                               "        RutaOriginal == \u0027RH-12-S\u0027, \u0027RH-12-S\u0027,",
                                               "        RutaOriginal == \u0027R12-S\u0027, \u0027RH-12-S\u0027,",
                                               "        startsWith(RutaOriginal, \u0027RH-\u0027), RutaOriginal,",
                                               "        concat(\u0027RH-\u0027, lpad(regexExtract(RutaOriginal, \u0027(\\\\d+)\u0027, 1), 2, \u00270\u0027))",
                                               "    ),",
                                               "    ParadaHistoricaIdLimpio = case(",
                                               "        ParadaOriginal == \u0027P220-MC-NEW\u0027, \u0027P220-MC-NEW\u0027,",
                                               "        ParadaOriginal == \u0027MC-01\u0027 \u0026\u0026 FechaServicioLimpia \u003e= toDate(\u00272023-07-01\u0027), \u0027P220-MC-NEW\u0027,",
                                               "        ParadaOriginal == \u0027MC-01\u0027, \u0027MC-01\u0027,",
                                               "        startsWith(ParadaOriginal, \u0027P\u0027), ParadaOriginal,",
                                               "        concat(\u0027P\u0027, lpad(regexExtract(ParadaOriginal, \u0027(\\\\d+)\u0027, 1), 3, \u00270\u0027))",
                                               "    )",
                                               ") ~\u003e NormalizarDemanda",
                                               "NormalizarDemanda select(mapColumn(",
                                               "    AnioFuente = AnioFuenteLimpio,",
                                               "    DemandaId = DemandaIdLimpio,",
                                               "    FechaServicio = FechaServicioLimpia,",
                                               "    RutaHistoricaId = RutaHistoricaIdLimpio,",
                                               "    ParadaHistoricaId = ParadaHistoricaIdLimpio,",
                                               "    Franja = FranjaLimpia,",
                                               "    ValidacionesTarjeta = ValidacionesLimpias,",
                                               "    Descensos = DescensosLimpios,",
                                               "    DemandaNoAtendida = NoAtendidaLimpia,",
                                               "    Metodo = MetodoLimpio",
                                               "),",
                                               "skipDuplicateMapInputs: true,",
                                               "skipDuplicateMapOutputs: true",
                                               ") ~\u003e SeleccionarDemanda",
                                               "SeleccionarDemanda sink(",
                                               "allowSchemaDrift: true,",
                                               "validateSchema: false,",
                                               "deletable: false,",
                                               "insertable: true,",
                                               "updateable: false,",
                                               "upsertable: false,",
                                               "format: \u0027table\u0027,",
                                               "skipDuplicateMapInputs: true,",
                                               "skipDuplicateMapOutputs: true,",
                                               "errorHandlingOption: \u0027stopOnFirstError\u0027",
                                               ") ~\u003e SinkSilverDemanda"
                                           ],
                           "transformations":  [
                                                   {
                                                       "name":  "PrepararDemanda"
                                                   },
                                                   {
                                                       "name":  "NormalizarDemanda"
                                                   },
                                                   {
                                                       "name":  "SeleccionarDemanda"
                                                   }
                                               ]
                       }
}
