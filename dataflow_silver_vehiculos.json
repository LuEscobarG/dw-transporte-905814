{
    "typeProperties":  {
                           "sources":  [
                                           {
                                               "name":  "SourceBronzeVehiculos",
                                               "dataset":  {
                                                               "referenceName":  "DS_Bronze_Vehiculos",
                                                               "type":  "DatasetReference"
                                                           }
                                           }
                                       ],
                           "sinks":  [
                                         {
                                             "name":  "SinkSilverVehiculos",
                                             "dataset":  {
                                                             "referenceName":  "DS_Silver_Vehiculos",
                                                             "type":  "DatasetReference"
                                                         }
                                         }
                                     ],
                           "scriptLines":  [
                                               "source(",
                                               "allowSchemaDrift: true,",
                                               "validateSchema: false,",
                                               "format: \u0027table\u0027",
                                               ") ~\u003e SourceBronzeVehiculos",
                                               "SourceBronzeVehiculos derive(",
                                               "    AnioFuenteLimpio = toShort(trim(toString(byName(\u0027AnioFuente\u0027)))),",
                                               "    VehiculoOriginal = upper(trim(toString(byName(\u0027VehiculoId\u0027)))),",
                                               "    PlacaLimpia = upper(trim(toString(byName(\u0027Placa\u0027)))),",
                                               "    TipoVehiculoLimpio = upper(trim(toString(byName(\u0027TipoVehiculo\u0027)))),",
                                               "    CapacidadLimpia = toInteger(toDecimal(trim(toString(byName(\u0027CapacidadEfectiva\u0027))), 10, 0)),",
                                               "    VigenciaDesdeLimpia = case(",
                                               "        isInteger(trim(toString(byName(\u0027VigenciaDesde\u0027)))),",
                                               "            addDays(toDate(\u00271899-12-30\u0027), toInteger(trim(toString(byName(\u0027VigenciaDesde\u0027))))),",
                                               "        instr(upper(trim(toString(byName(\u0027VigenciaDesde\u0027)))), \u0027AM\u0027) \u003e 0 || instr(upper(trim(toString(byName(\u0027VigenciaDesde\u0027)))), \u0027PM\u0027) \u003e 0,",
                                               "            toDate(toTimestamp(trim(toString(byName(\u0027VigenciaDesde\u0027))), \u0027M/d/yyyy hh:mm:ss a\u0027)),",
                                               "        instr(trim(toString(byName(\u0027VigenciaDesde\u0027))), \u0027/\u0027) \u003e 0,",
                                               "            toDate(trim(toString(byName(\u0027VigenciaDesde\u0027))), \u0027dd/MM/yyyy\u0027),",
                                               "        toDate(trim(toString(byName(\u0027VigenciaDesde\u0027))))",
                                               "    ),",
                                               "    VigenciaHastaLimpia = case(",
                                               "        isInteger(trim(toString(byName(\u0027VigenciaHasta\u0027)))),",
                                               "            addDays(toDate(\u00271899-12-30\u0027), toInteger(trim(toString(byName(\u0027VigenciaHasta\u0027))))),",
                                               "        instr(upper(trim(toString(byName(\u0027VigenciaHasta\u0027)))), \u0027AM\u0027) \u003e 0 || instr(upper(trim(toString(byName(\u0027VigenciaHasta\u0027)))), \u0027PM\u0027) \u003e 0,",
                                               "            toDate(toTimestamp(trim(toString(byName(\u0027VigenciaHasta\u0027))), \u0027M/d/yyyy hh:mm:ss a\u0027)),",
                                               "        instr(trim(toString(byName(\u0027VigenciaHasta\u0027))), \u0027/\u0027) \u003e 0,",
                                               "            toDate(trim(toString(byName(\u0027VigenciaHasta\u0027))), \u0027dd/MM/yyyy\u0027),",
                                               "        toDate(trim(toString(byName(\u0027VigenciaHasta\u0027))))",
                                               "    ),",
                                               "    EstadoLimpio = upper(trim(toString(byName(\u0027Estado\u0027))))",
                                               ") ~\u003e PrepararVehiculos",
                                               "PrepararVehiculos derive(",
                                               "    VehiculoBase = case(",
                                               "        startsWith(VehiculoOriginal, \u0027V-\u0027), VehiculoOriginal,",
                                               "        concat(\u0027V-\u0027, lpad(regexExtract(VehiculoOriginal, \u0027(\\\\d+)\u0027, 1), 3, \u00270\u0027))",
                                               "    )",
                                               ") ~\u003e NormalizarIdVehiculo",
                                               "NormalizarIdVehiculo derive(",
                                               "    VehiculoHistoricoId = iif(",
                                               "        VehiculoBase == \u0027V-043\u0027 \u0026\u0026 AnioFuenteLimpio \u003c= 2023,",
                                               "        \u0027V-043-OLD\u0027,",
                                               "        VehiculoBase",
                                               "    )",
                                               ") ~\u003e SepararHistorico043",
                                               "SepararHistorico043 window(",
                                               "    over(VehiculoHistoricoId),",
                                               "    desc(AnioFuenteLimpio, true),",
                                               "    FilaVehiculo = rowNumber()",
                                               ") ~\u003e NumerarVehiculos",
                                               "NumerarVehiculos filter(FilaVehiculo == 1) ~\u003e VehiculosUnicos",
                                               "VehiculosUnicos select(mapColumn(",
                                               "    AnioFuente = AnioFuenteLimpio,",
                                               "    VehiculoId = VehiculoHistoricoId,",
                                               "    Placa = PlacaLimpia,",
                                               "    TipoVehiculo = TipoVehiculoLimpio,",
                                               "    CapacidadEfectiva = CapacidadLimpia,",
                                               "    VigenciaDesde = VigenciaDesdeLimpia,",
                                               "    VigenciaHasta = VigenciaHastaLimpia,",
                                               "    Estado = EstadoLimpio",
                                               "),",
                                               "skipDuplicateMapInputs: true,",
                                               "skipDuplicateMapOutputs: true",
                                               ") ~\u003e SeleccionarVehiculos",
                                               "SeleccionarVehiculos sink(",
                                               "allowSchemaDrift: true,",
                                               "validateSchema: false,",
                                               "deletable: false,",
                                               "insertable: true,",
                                               "updateable: false,",
                                               "upsertable: false,",
                                               "format: \u0027table\u0027,",
                                               "skipDuplicateMapInputs: true,",
                                               "skipDuplicateMapOutputs: true,",
                                               "errorHandlingOption: \u0027stopOnFirstError\u0027",
                                               ") ~\u003e SinkSilverVehiculos"
                                           ],
                           "transformations":  [
                                                   {
                                                       "name":  "PrepararVehiculos"
                                                   },
                                                   {
                                                       "name":  "NormalizarIdVehiculo"
                                                   },
                                                   {
                                                       "name":  "SepararHistorico043"
                                                   },
                                                   {
                                                       "name":  "NumerarVehiculos"
                                                   },
                                                   {
                                                       "name":  "VehiculosUnicos"
                                                   },
                                                   {
                                                       "name":  "SeleccionarVehiculos"
                                                   }
                                               ]
                       }
}
